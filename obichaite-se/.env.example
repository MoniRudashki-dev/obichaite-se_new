DATABASE_URI=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Klaviyo integration ---
# Public API Key / Site ID (safe to expose in the browser)
NEXT_PUBLIC_KLAVIYO_PUBLIC_API_KEY=
# Client-side feature flag ("true" to load the onsite script)
NEXT_PUBLIC_KLAVIYO_ENABLED=true
# Private API Key (server only — never commit a real value)
KLAVIYO_PRIVATE_API_KEY=
# Newsletter / welcome-flow list id
KLAVIYO_NEWSLETTER_LIST_ID=
# API revision date sent on every private API request
KLAVIYO_API_REVISION=2026-04-15
# Server-side master switch ("false" disables all outbound Klaviyo calls)
KLAVIYO_ENABLED=true
# Environment marker attached to events/profiles (production | staging | development)
KLAVIYO_ENVIRONMENT=production
# Same marker exposed to the browser so client-side events are tagged correctly
NEXT_PUBLIC_KLAVIYO_ENVIRONMENT=production
# Verbose redacted logging
KLAVIYO_DEBUG=false
# Secret guarding the catalog sync route (?token=...)
KLAVIYO_CATALOG_SYNC_SECRET=
